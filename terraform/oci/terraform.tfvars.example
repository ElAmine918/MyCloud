# ==============================================================================
# Fichier d'exemple pour terraform.tfvars
# Copie ce fichier : cp terraform.tfvars.example terraform.tfvars
# ⚠️ Ne jamais commit "terraform.tfvars" (il est déjà exclu par .gitignore)
# ==============================================================================

# Identifiants Oracle Cloud (depuis User Settings > API Keys)
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaa..."
user_ocid        = "ocid1.user.oc1..aaaaaaa..."
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "ca-montreal-1" # Remplace par ta région (ex: ca-toronto-1, us-ashburn-1, eu-paris-1)

# Ta clé SSH publique sur ton Mac (pour pouvoir te connecter en SSH)
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Paramètres de l'instance Ampere A1 (Always Free permanent)
instance_ocpus          = 2   # 2 OCPUs ARM
instance_memory_in_gbs  = 12  # 12 Go de RAM
boot_volume_size_in_gbs = 50  # 50 Go de stockage
