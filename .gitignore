# ==========================================
# MyCloud - Homelab & Multi-Cloud .gitignore
# ==========================================

# --- OS & IDE files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Sensitive Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*
oci_api_key*

# --- Terraform ---
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data (passwords, tokens, keys)
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used only on local systems
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# --- Ansible ---
*.retry
.vault_pass*
vault_pass*
ansible_vault_pass*
hosts.secret*

# --- Kubernetes / K3s ---
*kubeconfig*
*.kubeconfig
admin.conf

# --- Logs & Temp ---
*.log
*.tmp
tmp/
scratch/
